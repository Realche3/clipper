# Copy to .env and fill in. NEVER commit .env.

# --- review ---
AUTO_APPROVE=false

# --- LLM ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# per-task models; empty = CLAUDE_MODEL (sounds defaults to claude-haiku-5-5)
# options: claude-opus-5-5 ($4/$20 per M tokens), claude-sonnet-5-5 ($2/$10), claude-haiku-5-5 ($0.10/$0.50)
CLAUDE_MODEL_RANK=
CLAUDE_MODEL_CAPTIONS=
CLAUDE_MODEL_SOUNDS=

# --- ingest ---
MAX_SOURCE_MINUTES=90
YTDLP_COOKIES_FROM_BROWSER=   # e.g. chrome, if YouTube blocks downloads

# --- analyze / render ---
CLIPS_PER_VIDEO=5
CANDIDATES=15
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=60
WHISPER_MODEL=small   # base if too slow
LAYOUT=blur
MUSIC_MODE=in_app

# --- captions ---
BASE_HASHTAGS=   # optional, added to every post: e.g. gta6,gaming (comma-separated, no #)

# --- publish ---
# --- trending sounds (comma-separated roundup pages; leave empty for the defaults) ---
TRENDING_SOURCES=

# --- posting (manual post kit) ---
TIKTOK_UPLOAD_URL=https://www.tiktok.com/tiktokstudio/upload
INSTAGRAM_UPLOAD_URL=https://www.instagram.com/
ENABLED_PLATFORMS=tiktok,instagram
POST_INTERVAL_MINUTES=90
POSTING_WINDOW=10:00-23:30
DAILY_CAP_TIKTOK=6
DAILY_CAP_INSTAGRAM=5
